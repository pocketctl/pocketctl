# Relay production environment template (deploy/lib/deployment-helpers.sh
# generates the real file with generated secrets; extension values below are
# the operator-supplied additions).
RELAY_EXTENSIONS=off
# When flipping to enabled, provision all three independent secrets/keys:
#   EXTENSION_PROVIDER_JWT_SECRET  (>= 32 chars, HS256 provider tokens)
#   EXTENSION_CURSOR_SECRET        (>= 32 chars, feed cursor HMAC)
#   EXTENSION_GRANT_PRIVATE_KEY_B64 / EXTENSION_GRANT_PUBLIC_KEY_B64
#     (base64 of the RSA PEM pair; safe for systemd EnvironmentFile)
#   EXTENSION_GRANT_KEY_ID         (stable signing kid)
# Numeric knobs (defaults shown):
# RELAY_EXTENSION_PROJECTOR_BATCH=200
# RELAY_EXTENSION_FEED_RETENTION_DAYS=7
# RELAY_EXTENSION_LEASE_TTL_SECONDS=60
# Per-endpoint rate budgets (requests/minute):
# RELAY_EXTENSION_RATE_LIMIT_TOKEN=30
# RELAY_EXTENSION_RATE_LIMIT_FEED=120
# RELAY_EXTENSION_RATE_LIMIT_ACK=240
# RELAY_EXTENSION_RATE_LIMIT_SNAPSHOT=60
# RELAY_EXTENSION_RATE_LIMIT_STATUS=120
# RELAY_EXTENSION_RATE_LIMIT_USAGE=60
# RELAY_EXTENSION_RATE_LIMIT_PURGE=60
# RELAY_EXTENSION_RATE_LIMIT_GRANT=60
# RELAY_EXTENSION_RATE_LIMIT_INSTALLATIONS=120
# EXTENSION_PROVIDER_PUBLIC_ORIGINS={"pocketctl-memory":"https://memory.example"}

# ---- PocketCtl Memory Phase 0 (independent service) ----
# Required when the memory-* services ship (docker-compose.prod.yml fails
# closed without each of these). All values are operator-provided secrets.
MEMORY_MODE=enabled
MEMORY_POSTGRES_PASSWORD=
MEMORY_RELAY_URL=http://relay:8080
# Must equal the Relay's PUBLIC_ISSUER_URL (the origin it signs grants
# with), NOT the in-cluster URL — a mismatch makes every grant 401.
MEMORY_RELAY_ISSUER=https://www.pocketctl.me
MEMORY_PROVIDER_CLIENT_ID=
MEMORY_PROVIDER_CLIENT_SECRET=
# >= 32 random bytes; rotating it invalidates outstanding purge receipts.
MEMORY_HMAC_KEY=
MEMORY_WORKER_ID=memory-worker-1
MEMORY_LOG_LEVEL=info
# Phase 1 model providers (optional; per-installation feature modes default to off)
# MEMORY_TEXT_PROVIDER=openai-compatible
# MEMORY_TEXT_BASE_URL=https://api.model.example/v1
# MEMORY_TEXT_MODEL=
# MEMORY_TEXT_API_KEY=
# MEMORY_TEXT_THINKING=
# MEMORY_TEXT_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MEMORY_TEXT_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MEMORY_EMBEDDING_PROVIDER=openai-compatible
# MEMORY_EMBEDDING_BASE_URL=https://api.model.example/v1
# MEMORY_EMBEDDING_MODEL=
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_EMBEDDING_DIMENSIONS=1536
# MEMORY_EMBEDDING_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MEMORY_EMBEDDING_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MEMORY_MODEL_TIMEOUT_MS=30000
# MEMORY_RECALL_EMBEDDING_TIMEOUT_MS=2000
# MEMORY_EXTRACTION_MAX_CHARS=200000
# MEMORY_EXTRACTION_DEBOUNCE_MS=120000
# MEMORY_EXTRACTION_MAX_RUNS_PER_EPISODE=1
# MEMORY_EXTRACTION_NOT_BEFORE=2026-08-31T00:29:36.000Z
# Persistent Provider budget is all-or-nothing; rotate the key only for a
# newly approved rollout budget.
# MEMORY_PROVIDER_BUDGET_KEY=phase3-pilot-c
# MEMORY_TEXT_BUDGET_MAX_REQUESTS=50
# MEMORY_TEXT_BUDGET_MAX_INPUT_TOKENS=200000
# MEMORY_TEXT_BUDGET_MAX_OUTPUT_TOKENS=50000
# MEMORY_TEXT_MAX_OUTPUT_TOKENS_PER_REQUEST=4096
# MEMORY_EMBEDDING_BUDGET_MAX_REQUESTS=200
# MEMORY_EMBEDDING_BUDGET_MAX_TOKENS=500000
# MEMORY_ALLOWED_ORIGINS=https://web.example
# MEMORY_ALLOWED_HOSTS=memory.example
MEMORY_TOMBSTONE_HMAC_KEYS=

# ---- Phase 2 context (defaults OFF; plan section 17) ----
# Bounded enrichment deadline and admission TTL are code-frozen (750ms / 5s).
# Query HMAC key ring: comma-separated versioned keys; first entry signs new requests.
MEMORY_CONTEXT_QUERY_HMAC_KEYS=
# ADR-0005 Phase 3 feature flags; production default off.
RELAY_EXTENSION_V2=off
