# PocketCtl Memory native production EnvironmentFile.
# Install as /opt/pocketctl/memory/.env, owned by root:pocketctl and mode 0640.
# Replace every angle-bracket placeholder before starting either systemd unit.
NODE_ENV=production
MEMORY_MODE=enabled
MEMORY_PORT=8090
MEMORY_API_BIND=loopback
MEMORY_METRICS_PORT=8091
MEMORY_METRICS_BIND=loopback

# Independent PostgreSQL database. Do not point this at Relay's pocketctl DB.
MEMORY_DATABASE_URL=postgresql://pocketctl_memory_app:<database-password>@<database-host>:5432/pocketctl_memory
# 2 vCPU / 4 GB single-user canary: API and Worker each have a pool of 2.
MEMORY_DB_POOL_MAX=2

# Relay is reached over loopback; grants are verified against its public issuer.
MEMORY_RELAY_URL=http://127.0.0.1:8080
MEMORY_RELAY_ISSUER=https://www.pocketctl.me
MEMORY_PROVIDER_ID=pocketctl-memory
MEMORY_PROVIDER_CLIENT_ID=<relay-provider-client-id>
MEMORY_PROVIDER_CLIENT_SECRET=<relay-provider-client-secret>

MEMORY_WORKER_ID=memory-worker-1
MEMORY_POLL_INTERVAL_MS=1000
MEMORY_HTTP_TIMEOUT_MS=10000
MEMORY_JOB_LEASE_MS=30000
MEMORY_EPISODE_STABILIZATION_MS=30000
MEMORY_EXTRACTION_DEBOUNCE_MS=120000
MEMORY_EXTRACTION_MAX_RUNS_PER_EPISODE=1
MEMORY_EXTRACTION_NOT_BEFORE=<pilot-start-utc-or-empty>
MEMORY_HMAC_KEY=<existing-memory-hmac-key-at-least-32-bytes>
MEMORY_TOMBSTONE_HMAC_KEYS=v1=<existing-tombstone-hmac-key-at-least-32-bytes>
MEMORY_LOG_LEVEL=info

# DeepSeek text extraction through the OpenAI-compatible adapter.
MEMORY_TEXT_PROVIDER=openai-compatible
MEMORY_TEXT_BASE_URL=https://api.deepseek.com
MEMORY_TEXT_MODEL=deepseek-v4-flash
MEMORY_TEXT_API_KEY=<deepseek-api-key>
MEMORY_TEXT_THINKING=disabled

# Alibaba Cloud Model Studio workspace-compatible endpoint.
MEMORY_EMBEDDING_PROVIDER=openai-compatible
MEMORY_EMBEDDING_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding
MEMORY_EMBEDDING_API_KEY=<dashscope-api-key>
MEMORY_EMBEDDING_DIMENSIONS=1024

MEMORY_MODEL_TIMEOUT_MS=30000
MEMORY_RECALL_EMBEDDING_TIMEOUT_MS=2000
MEMORY_EXTRACTION_MAX_CHARS=200000
MEMORY_PROVIDER_BUDGET_KEY=<approved-rollout-budget-key>
MEMORY_TEXT_BUDGET_MAX_REQUESTS=<approved-request-cap>
MEMORY_TEXT_BUDGET_MAX_INPUT_TOKENS=<approved-input-token-cap>
MEMORY_TEXT_BUDGET_MAX_OUTPUT_TOKENS=<approved-output-token-cap>
MEMORY_TEXT_MAX_OUTPUT_TOKENS_PER_REQUEST=<per-request-output-cap>
MEMORY_EMBEDDING_BUDGET_MAX_REQUESTS=<approved-request-cap>
MEMORY_EMBEDDING_BUDGET_MAX_TOKENS=<approved-token-cap>
MEMORY_ALLOWED_ORIGINS=https://www.pocketctl.me
MEMORY_ALLOWED_HOSTS=memory.pocketctl.me
# ADR-0005 Phase 3 feature flag; production default off.
MEMORY_SHARED_SCOPES=off

# ADR-0006 Phase 4 features are independent and default off. Shadow permits
# explicit fixture/local candidate work; publication always remains manual.
MEMORY_CODEGRAPH_MODE=off
MEMORY_WIKI_MODE=off
MEMORY_CODEGRAPH_MAX_CONCURRENCY=1
MEMORY_WIKI_MAX_CONCURRENCY=1
MEMORY_WIKI_MAX_PAGES=32
MEMORY_WIKI_MAX_SECTIONS=256
MEMORY_WIKI_MAX_SOURCE_CHARS=200000
MEMORY_CODE_SNAPSHOT_RETENTION_DAYS=30

# Optional Wiki generation has a separate approval ledger. Leave every value
# empty to use the deterministic skeleton and make zero model calls.
MEMORY_WIKI_PROVIDER_BUDGET_KEY=
MEMORY_WIKI_TEXT_REQUEST_LIMIT=
MEMORY_WIKI_TEXT_INPUT_TOKEN_LIMIT=
MEMORY_WIKI_TEXT_OUTPUT_TOKEN_LIMIT=
MEMORY_WIKI_TEXT_MAX_OUTPUT_TOKENS_PER_REQUEST=
