# Native PocketCtl Memory public origin. Replace certificate paths only after
# DNS and certificate coverage for memory.pocketctl.me have been verified.
server {
    listen 80;
    listen [::]:80;
    server_name memory.pocketctl.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name memory.pocketctl.me;

    ssl_certificate /etc/letsencrypt/live/memory.pocketctl.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/memory.pocketctl.me/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64k;

    # Metrics remain a loopback-only operations surface.
    location = /metrics {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }

    location ~ /\. {
        deny all;
    }
}
