# PocketCtl Memory shared-origin routes.
#
# Install these locations inside the existing HTTPS server block for
# www.pocketctl.me. The main site certificate is reused; Memory does not need
# a subdomain or a second certificate. This is a reviewed snippet, not a
# standalone nginx http/server configuration.

location = /metrics {
    deny all;
    access_log off;
}

# Relay keeps ownership of /health. Memory uses explicit operations paths.
location = /memory-health {
    proxy_pass http://127.0.0.1:8090/health;
    proxy_set_header Host $host;
    access_log off;
}

location = /memory-ready {
    proxy_pass http://127.0.0.1:8090/ready;
    proxy_set_header Host $host;
    access_log off;
}

location = /api/v1/probe {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
}

# This more-specific prefix wins over Relay's existing /api/ location.
location /api/v1/memory/ {
    proxy_pass http://127.0.0.1:8090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;
}

location = /mcp {
    proxy_pass http://127.0.0.1:8090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    client_max_body_size 256k;
}
