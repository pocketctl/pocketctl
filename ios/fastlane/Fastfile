default_platform(:ios)

platform :ios do
  desc "构建 Debug 版本"
  lane :build do
    xcodebuild(
      project: "Pocketctl.xcodeproj",
      scheme: "Pocketctl",
      configuration: "Debug",
      destination: "generic/platform=iOS",
      clean: true,
      build: true
    )
  end

  desc "构建 + Archive Release 版本"
  lane :archive do |options|
    # 自动递增 build number
    latest_testflight_build_number(
      app_identifier: "com.pocketctl.app"
    )
    increment_build_number

    # Archive
    gym(
      project: "Pocketctl.xcodeproj",
      scheme: "Pocketctl",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios",
      clean: true,
      silent: true
    )

    UI.success "✅ Archive 完成: #{Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]}"
  end

  desc "构建 + 上传到 TestFlight"
  lane :beta do |options|
    # 自动递增 build number
    latest_testflight_build_number(
      app_identifier: "com.pocketctl.app"
    )
    increment_build_number

    # Archive
    gym(
      project: "Pocketctl.xcodeproj",
      scheme: "Pocketctl",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios",
      clean: true,
      silent: true
    )

    # 上传到 TestFlight
    upload_to_testflight(
      app_identifier: "com.pocketctl.app",
      skip_waiting_for_build_processing: true
    )

    UI.success "✅ 已上传到 TestFlight"
  end

  desc "提交到 App Store 审核"
  lane :release do |options|
    # 先执行 beta
    beta

    # 提交审核
    deliver(
      app_identifier: "com.pocketctl.app",
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    UI.success "✅ 已提交 App Store 审核"
  end

  desc "更新 App Store 元数据（截图、描述等）"
  lane :metadata do
    deliver(
      app_identifier: "com.pocketctl.app",
      skip_binary_upload: true,
      skip_screenshots: false
    )
  end

  error do |lane, exception|
    UI.error "❌ 构建失败: #{exception.message}"
  end
end
