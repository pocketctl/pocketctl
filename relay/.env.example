# pocketctl Relay 环境变量配置

# --- 必填 ---
# WebSocket 认证密钥（生产环境必须设置）
POCKETCTL_API_KEY=change-me-to-a-strong-random-string

# PostgreSQL 连接字符串
DATABASE_URL=postgresql://pocketctl:your-password@localhost:5432/pocketctl

# --- 可选 ---
# Relay 监听端口
PORT=8080

# 运行环境: development | production
NODE_ENV=production

# CORS 允许的域名（逗号分隔，留空则允许所有）
# 生产环境建议设置，例如: https://pocketctl.com,https://www.pocketctl.com
ALLOWED_ORIGINS=

# WebSocket 消息大小限制（字节，默认 1MB）
MAX_WS_MESSAGE_SIZE=1048576

# 速率限制：时间窗口（毫秒，默认 60 秒）
RATE_LIMIT_WINDOW_MS=60000

# 速率限制：最大连接数（默认 30/分钟/IP）
RATE_LIMIT_MAX_CONNECTIONS=30

# 智谱 AI API Key（用于 session 标题自动生成）
# 从 https://open.bigmodel.cn 控制台获取
# 未设置时跳过 LLM 标题生成，使用默认名称
ZHIPU_API_KEY=

# --- 腾讯云短信（SMS）---
# 腾讯云 API 密钥（与 COS_SECRET_ID / COS_SECRET_KEY 相同）
COS_SECRET_ID=
COS_SECRET_KEY=
# 短信应用 SDK AppID
SMS_SDK_APP_ID=
# 短信签名名称
SMS_SIGN_NAME=北京乐呵乐呵信息
# 短信模板 ID
SMS_TEMPLATE_ID=2661504
# 开发模式测试手机号（仅 development 环境生效）
DEV_SMS_PHONE=13800138000
# 开发模式测试验证码（仅 development 环境生效）
DEV_SMS_CODE=000000
