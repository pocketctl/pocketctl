# pocketctl Relay 环境变量配置

# --- 必填 ---
# JWT 签名密钥（生产环境必须设置强随机字符串）
JWT_SECRET=

# PostgreSQL 连接字符串
DATABASE_URL=postgresql://pocketctl:your-password@localhost:5432/pocketctl

# --- 可选 ---
# Relay 监听端口
PORT=8080

# Relay 监听地址。开发默认 0.0.0.0；systemd 生产部署固定 127.0.0.1（由
# 前置 Nginx 反代）；容器内显式 0.0.0.0。
# 生产模式下非回环监听必须同时配置 TRUSTED_PROXY_CIDRS，否则启动失败。
RELAY_HOST=127.0.0.1

# M-1 可信反向代理列表（逗号分隔的 IP/CIDR）。只有来自这些地址的连接，
# 其 X-Forwarded-For / X-Real-IP 才会影响 Fastify 的 req.ip；其他直连
# peer 的自报转发头一律忽略。生产禁止 TRUST_PROXY=true（trust-all）。
# systemd（Nginx 与 Relay 同机）：127.0.0.1/8,::1/128
# docker-compose.prod.yml（Nginx 固定内部地址）：172.30.0.2/32
TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128

# 运行环境: development | production
NODE_ENV=production

# Persistent Attention Inbox rollout: off -> observe -> on. Default is off.
ATTENTION_INBOX_V1=off

# --- Apple Push Notification Service（iOS 真机推送必填）---
# systemd 部署填写服务器上的绝对路径；Docker 部署填写容器内路径
# /run/secrets/apns/AuthKey.p8，并用 APNS_KEY_DIR 挂载宿主机密钥目录。
APNS_KEY_PATH=/run/secrets/apns/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.pocketctl.app
# Debug 真机包使用 development；Release/TestFlight 使用 production。
APNS_ENVIRONMENT=production

# Web 客户端地址（用于 OAuth/邮箱验证码登录的验证链接）
# 生产必填，否则 fallback 到 http://<hostname>:<PORT> 导致链接带端口
WEB_APP_URL=https://www.pocketctl.me

# CORS 允许的域名（逗号分隔）。留空会 fallback 到 origin:true（允许任意站点带
# token 调 REST），生产务必锁定。docker-compose.prod.yml 已内置默认值，自托管请按需修改。
ALLOWED_ORIGINS=https://www.pocketctl.me,https://pocketctl.me

# WebSocket 消息大小限制（字节，默认 1MB）。协议层 maxPayload 与认证后
# processMessage 检查共用该值（M-3 双层防护）。
MAX_WS_MESSAGE_SIZE=1048576

# M-3 认证前缓冲上限：单连接在 JWT/ticket 校验完成前最多缓存的早到消息
# 数与总字节数。超限立即以 1009 关闭并丢弃缓冲,认证即使稍后成功也不进入
# Router。PREAUTH_MAX_BYTES 不得超过 2 x MAX_WS_MESSAGE_SIZE。
#RELAY_PREAUTH_MAX_MESSAGES=4
#RELAY_PREAUTH_MAX_BYTES=2097152

# 速率限制：时间窗口（毫秒，默认 60 秒）
RATE_LIMIT_WINDOW_MS=60000

# 速率限制：最大连接数（默认 30/分钟/IP）
RATE_LIMIT_MAX_CONNECTIONS=30

# 速率限制：突发窗口（毫秒，默认 10 秒）—— 拦截每秒级重连风暴/粗暴 DoS
RATE_LIMIT_BURST_WINDOW_MS=10000

# 速率限制：突发窗口内最大连接数（默认 5/10秒/IP）
RATE_LIMIT_BURST_MAX=5

# 认证失败封禁阈值：同一 IP 连续失败到此次数后，按阶梯递增封禁
# （30s→2m→10m→30m）。这是静默"失效 token 僵尸 daemon"的关键——
# 无效 token 必然每次重连都鉴权失败，于是爬上封禁阶梯自动安静，
# 不依赖客户端升级。默认 3。
RATE_LIMIT_AUTH_FAIL_THRESHOLD=3

# --- M-2 HTTP 认证端点限流（PostgreSQL 原子计数，跨 Relay 实例共享）---
# 所有值必须为严格正整数；非法值导致启动失败。键只存 HMAC 指纹，
# 不存邮箱/IP/device code/token 明文。数据库故障时认证创建/验证端点
# fail closed（503）。以下为默认预算（窗口固定在代码中，见策略矩阵）：
#   register/login/apple:      10/IP/15min + 5/账号/15min
#   email send:               10/IP/h + 5/邮箱/h；verify: 30/IP/15min
#   bind send/verify:         同 email send/verify
#   device authorize/QR create: 10/IP/min + 100/IP/h
#   device token/QR status:   120/IP/min（协议级 per-code 间隔另计）
#   device/QR confirm:        10/user/10min + 30/IP/10min
#   refresh/logout/revoke:    30/token/min + 120/IP/min
#   ws-ticket:                30/user/min + 120/IP/min
#AUTH_RATE_LIMIT_REGISTER_IP_MAX=10
#AUTH_RATE_LIMIT_REGISTER_IDENTITY_MAX=5
#AUTH_RATE_LIMIT_LOGIN_IP_MAX=10
#AUTH_RATE_LIMIT_LOGIN_IDENTITY_MAX=5
#AUTH_RATE_LIMIT_APPLE_IP_MAX=10
#AUTH_RATE_LIMIT_EMAIL_SEND_IP_MAX=10
#AUTH_RATE_LIMIT_EMAIL_SEND_EMAIL_MAX=5
#AUTH_RATE_LIMIT_EMAIL_VERIFY_IP_MAX=30
#AUTH_RATE_LIMIT_BIND_SEND_IP_MAX=10
#AUTH_RATE_LIMIT_BIND_SEND_EMAIL_MAX=5
#AUTH_RATE_LIMIT_BIND_VERIFY_IP_MAX=30
#AUTH_RATE_LIMIT_DEVICE_AUTHORIZE_PER_MINUTE=10
#AUTH_RATE_LIMIT_DEVICE_AUTHORIZE_PER_HOUR=100
#AUTH_RATE_LIMIT_QR_CREATE_PER_MINUTE=10
#AUTH_RATE_LIMIT_QR_CREATE_PER_HOUR=100
#AUTH_RATE_LIMIT_POLL_IP_MAX=120
#AUTH_RATE_LIMIT_CONFIRM_USER_MAX=10
#AUTH_RATE_LIMIT_CONFIRM_IP_MAX=30
#AUTH_RATE_LIMIT_TOKEN_OPS_TOKEN_MAX=30
#AUTH_RATE_LIMIT_TOKEN_OPS_IP_MAX=120
#AUTH_RATE_LIMIT_WS_TICKET_USER_MAX=30
#AUTH_RATE_LIMIT_WS_TICKET_IP_MAX=120

# daemon 断线后判定离线的宽限窗口（毫秒，默认 30 秒）。在此窗口内重连不会
# 触发"离线"推送与广播，避免 relay 重启/瞬时抖动造成的离线-上线抖动。
DAEMON_OFFLINE_GRACE_MS=30000

# DeepSeek API Key（用于 session 标题自动生成，模型 deepseek-v4-flash）
# 从 https://platform.deepseek.com 控制台获取
# 未设置时跳过 LLM 标题生成，使用默认名称
DEEPSEEK_API_KEY=

# --- 腾讯云短信（SMS）---
# 邮箱验证码 pepper（生产必填，>=32 字符随机串；不要复用 JWT_SECRET 或数据库密码）。
# 验证码只以 HMAC-SHA256(pepper, code) 形式落库；丢失 pepper 会使所有在途验证码失效。
AUTH_CODE_PEPPER=
# --- 开发模式邮箱验证码（仅 development 环境生效）---
# 必须同时设置 DEV_EMAIL 和 6 位 DEV_EMAIL_CODE 才启用；生产出现任一变量都会拒绝启动。
DEV_EMAIL=
DEV_EMAIL_CODE=
# 腾讯云 API 密钥（SES 邮件服务也复用此密钥）
COS_SECRET_ID=
COS_SECRET_KEY=
# 短信应用 SDK AppID
SMS_SDK_APP_ID=
# 短信签名名称
SMS_SIGN_NAME=
# 短信模板 ID
SMS_TEMPLATE_ID=

# --- 腾讯云 SES 邮件发送 ---
# 发件人邮箱（必须在 SES 控制台验证通过）
SES_FROM_EMAIL=
# SES 独立密钥（留空则降级读取 COS_SECRET_ID / COS_SECRET_KEY）
# SES_SECRET_ID=
# SES_SECRET_KEY=
# SES 区域（默认 ap-hongkong）
# SES_REGION=ap-hongkong
# 验证码模板 ID（中文 / 英文）
# SES_TEMPLATE_ZH=187105
# SES_TEMPLATE_EN=187106
# 欢迎邮件发件人和模板 ID（可选，已内置生产默认值）
# SES_WELCOME_FROM_EMAIL=welcome@mail.pocketctl.me
# SES_WELCOME_TEMPLATE_ZH=204007
# SES_WELCOME_TEMPLATE_EN=204008

# --- 开发模式（仅 development 环境生效）---
# 开发模式测试手机号
DEV_SMS_PHONE=
# 开发模式测试验证码
DEV_SMS_CODE=
