# pocketctl Relay 环境变量配置

# --- 必填 ---
# JWT 签名密钥（生产环境必须设置强随机字符串）
JWT_SECRET=

# PostgreSQL 连接字符串
DATABASE_URL=postgresql://pocketctl:your-password@localhost:5432/pocketctl

# --- 可选 ---
# Relay 监听端口
PORT=8080

# 运行环境: development | production
NODE_ENV=production

# Web 客户端地址（用于 OAuth/邮箱验证码登录的验证链接）
# 生产必填，否则 fallback 到 http://<hostname>:<PORT> 导致链接带端口
WEB_APP_URL=https://www.pocketctl.me

# CORS 允许的域名（逗号分隔）。留空会 fallback 到 origin:true（允许任意站点带
# token 调 REST），生产务必锁定。docker-compose.prod.yml 已内置默认值，自托管请按需修改。
ALLOWED_ORIGINS=https://www.pocketctl.me,https://pocketctl.me

# WebSocket 消息大小限制（字节，默认 1MB）
MAX_WS_MESSAGE_SIZE=1048576

# 速率限制：时间窗口（毫秒，默认 60 秒）
RATE_LIMIT_WINDOW_MS=60000

# 速率限制：最大连接数（默认 30/分钟/IP）
RATE_LIMIT_MAX_CONNECTIONS=30

# 速率限制：突发窗口（毫秒，默认 10 秒）—— 拦截每秒级重连风暴/粗暴 DoS
RATE_LIMIT_BURST_WINDOW_MS=10000

# 速率限制：突发窗口内最大连接数（默认 5/10秒/IP）
RATE_LIMIT_BURST_MAX=5

# 认证失败封禁阈值：同一 IP 连续失败到此次数后，按阶梯递增封禁
# （30s→2m→10m→30m）。这是静默"失效 token 僵尸 daemon"的关键——
# 无效 token 必然每次重连都鉴权失败，于是爬上封禁阶梯自动安静，
# 不依赖客户端升级。默认 3。
RATE_LIMIT_AUTH_FAIL_THRESHOLD=3

# daemon 断线后判定离线的宽限窗口（毫秒，默认 30 秒）。在此窗口内重连不会
# 触发"离线"推送与广播，避免 relay 重启/瞬时抖动造成的离线-上线抖动。
DAEMON_OFFLINE_GRACE_MS=30000

# DeepSeek API Key（用于 session 标题自动生成，模型 deepseek-v4-flash）
# 从 https://platform.deepseek.com 控制台获取
# 未设置时跳过 LLM 标题生成，使用默认名称
DEEPSEEK_API_KEY=

# --- 腾讯云短信（SMS）---
# 腾讯云 API 密钥（SES 邮件服务也复用此密钥）
COS_SECRET_ID=
COS_SECRET_KEY=
# 短信应用 SDK AppID
SMS_SDK_APP_ID=
# 短信签名名称
SMS_SIGN_NAME=
# 短信模板 ID
SMS_TEMPLATE_ID=

# --- 腾讯云 SES 邮件发送 ---
# 发件人邮箱（必须在 SES 控制台验证通过）
SES_FROM_EMAIL=
# SES 独立密钥（留空则降级读取 COS_SECRET_ID / COS_SECRET_KEY）
# SES_SECRET_ID=
# SES_SECRET_KEY=
# SES 区域（默认 ap-hongkong）
# SES_REGION=ap-hongkong
# 验证码模板 ID（中文 / 英文）
# SES_TEMPLATE_ZH=187105
# SES_TEMPLATE_EN=187106

# --- 开发模式（仅 development 环境生效）---
# 开发模式测试手机号
DEV_SMS_PHONE=
# 开发模式测试验证码
DEV_SMS_CODE=

# --- Legacy API Key（可选）---
POCKETCTL_API_KEY=
