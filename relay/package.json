{
  "name": "@pocketctl/relay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/event-worker-main.js",
    "preflight:token-usage": "node dist/token-usage-preflight-main.js",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "prom-client": "15.1.3",
    "tencentcloud-sdk-nodejs-ses": "^4.1.240",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
    "uuid": "^11.0.0"
  },
  "overrides": {
    "uuid": "$uuid",
    "find-my-way": "^9.7.0",
    "fast-uri": "^3.1.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
